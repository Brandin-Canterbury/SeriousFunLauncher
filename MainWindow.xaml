<Window x:Class="SeriousFunLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SeriousFun Launcher"
        Width="620" SizeToContent="Height" ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBrush}"
        Loaded="OnLoaded" Closing="OnClosing">
    <StackPanel Margin="28,24,28,24">
        <TextBlock Text="SeriousFun" FontSize="30" FontWeight="SemiBold" />
        <TextBlock Text="Ultima Online · private shard" Foreground="{StaticResource MutedBrush}"
                   FontSize="13" Margin="0,2,0,22" />

        <Border Background="{StaticResource PanelBrush}" CornerRadius="6" Padding="18">
            <StackPanel>
                <TextBlock Text="SERVER" Style="{StaticResource LabelText}" />
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="90" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="ServerHostBox" Grid.Column="0" ToolTip="Server address" />
                    <TextBox x:Name="ServerPortBox" Grid.Column="2" ToolTip="Port" />
                </Grid>

                <TextBlock Text="UO CLASSIC FOLDER" Style="{StaticResource LabelText}" />
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="UoDirectoryBox" Grid.Column="0" />
                    <Button Grid.Column="2" Content="Browse" Click="OnBrowseUo" />
                </Grid>

                <TextBlock Text="TAZUO FOLDER" Style="{StaticResource LabelText}" />
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="TazUoDirectoryBox" Grid.Column="0" />
                    <Button Grid.Column="2" Content="Browse" Click="OnBrowseTazUo" />
                </Grid>

                <CheckBox x:Name="CheckClientUpdatesBox" Content="Check for UO client updates before playing" />
                <CheckBox x:Name="CloseOnLaunchBox" Content="Close launcher when the game starts" Margin="0" />
            </StackPanel>
        </Border>

        <TextBlock x:Name="StatusText" Text="Ready." Margin="0,20,0,8" FontSize="13" TextWrapping="Wrap" />
        <ProgressBar x:Name="Progress" Minimum="0" Maximum="1" Value="0" />
        <TextBlock x:Name="VersionText" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,8,0,0" />

        <Grid Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button x:Name="RepairButton" Grid.Column="0" Content="Repair / update client" Click="OnRepair" />
            <Button x:Name="PlayButton" Grid.Column="2" Content="Play" Style="{StaticResource PrimaryButton}"
                    Click="OnPlay" IsDefault="True" />
        </Grid>
    </StackPanel>
</Window>
